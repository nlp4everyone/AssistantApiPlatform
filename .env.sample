# Port config
FASTAPI_PORT=8005
REDIS_PORT=6379
POSTGRES_PORT=5432
MLFLOW_PORT=5000
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

# API Config
NUM_WORKERS=1
# API Key
SERVING_API_KEY=token

# LLM serving config (external OpenAI-compatible server, e.g. vLLM/SGLang)
LLM_MODEL_NAME=Qwen/Qwen3-4B-AWQ
